# Razorpay Test Mode credentials (Settings -> API Keys in Razorpay dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Webhook secret (Settings -> Webhooks -> the one you set when creating the webhook)
RAZORPAY_WEBHOOK_SECRET=

# Anthropic API key, used only for ambiguous/edge-case recovery decisions
ANTHROPIC_API_KEY=

# Local DB (sqlite file, zero setup needed)
DATABASE_URL=sqlite:///./recovery.db
